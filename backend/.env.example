# Copy to .env on the server (deploy/setup-env.sh does this) and keep it chmod 600.
# Never commit .env or paste its values anywhere.

# Docker project name. Use a different value (e.g. pca-staging) for a staging copy.
PCA_STACK_NAME=pca
# Localhost-only port for the API on the host. Change if already taken.
PCA_API_HOST_PORT=18080

# Database credentials for the bundled Postgres. Use hex only (deploy/setup-env.sh generates one).
POSTGRES_DB=pca
POSTGRES_USER=pca
POSTGRES_PASSWORD=

PCA_LOG_LEVEL=INFO

# From @BotFather for @prochannelauditor_bot.
PCA_BOT_TOKEN=
PCA_BOT_USERNAME=prochannelauditor_bot

# Comma-separated numeric Telegram user IDs (get yours from @userinfobot). Usernames are rejected.
PCA_ADMIN_TELEGRAM_IDS=

# The bot resolves the numeric id from the username at startup. The bot must be an admin of the channel.
PCA_REQUIRED_CHANNEL_ID=
PCA_REQUIRED_CHANNEL_USERNAME=prochannelauditor
PCA_REQUIRED_CHANNEL_URL=https://t.me/prochannelauditor
PCA_SUBSCRIPTION_ENFORCED=true
PCA_SUBSCRIPTION_CACHE_SECONDS=120

PCA_SUPPORT_CONTACT=@prochannelauditor
# --- Account connection (Phase 2). Leave PCA_PUBLIC_BASE_URL empty to keep it switched off. ---
# Public HTTPS address that Caddy routes to the API, e.g. https://connect.example.com
PCA_PUBLIC_BASE_URL=
# From https://my.telegram.org -> API development tools.
PCA_TELEGRAM_API_ID=
PCA_TELEGRAM_API_HASH=
# Session encryption keys, "keyid:base64-32-bytes", comma-separated for rotation.
# deploy/setup-env.sh generates one. Losing this key makes every stored session unreadable.
PCA_SESSION_KEYS=
PCA_SESSION_ACTIVE_KEY_ID=

# --- Payments (Paystack). Leave the secret key empty to keep buying switched off. ---
# Paystack Dashboard -> Settings -> API Keys & Webhooks. sk_test_... for testing, sk_live_... for real money.
# The same key also signs webhooks, so there is no separate webhook secret.
PCA_PAYSTACK_SECRET_KEY=
# In the same Paystack page, set the Webhook URL to: <PCA_PUBLIC_BASE_URL>/webhooks/paystack
# Optional. Defaults to <PCA_PUBLIC_BASE_URL>/payments/callback.
PCA_PAYSTACK_CALLBACK_URL=
# Unpaid checkouts are marked abandoned after this many minutes (late payments are still credited).
PCA_PAYMENT_PENDING_EXPIRY_MINUTES=120
