PCA_ENVIRONMENT=development
PCA_LOG_LEVEL=INFO

# From @BotFather. Never commit the real value.
PCA_BOT_TOKEN=
PCA_BOT_USERNAME=prochannelauditor_bot

PCA_DATABASE_URL=postgresql+asyncpg://pca:pca@localhost:5432/pca
PCA_REDIS_URL=redis://localhost:6379/0

# Comma-separated numeric Telegram user IDs. Usernames are rejected.
PCA_ADMIN_TELEGRAM_IDS=

# Numeric chat id of @prochannelauditor (e.g. -100...). The bot must be an admin there.
PCA_REQUIRED_CHANNEL_ID=
PCA_REQUIRED_CHANNEL_USERNAME=prochannelauditor
PCA_REQUIRED_CHANNEL_URL=https://t.me/prochannelauditor
PCA_SUBSCRIPTION_ENFORCED=true
PCA_SUBSCRIPTION_CACHE_SECONDS=120

PCA_SUPPORT_CONTACT=@prochannelauditor
PCA_PUBLIC_BASE_URL=http://localhost:8000
