# Copy to .env on the server (deploy/setup-env.sh does this) and keep it chmod 600.
# Never commit .env or paste its values anywhere.

# Docker project name. Use a different value (e.g. pca-staging) for a staging copy.
PCA_STACK_NAME=pca
# Localhost-only port for the API on the host. Change if already taken.
PCA_API_HOST_PORT=18080

# Database credentials for the bundled Postgres. Use hex only (deploy/setup-env.sh generates one).
POSTGRES_DB=pca
POSTGRES_USER=pca
POSTGRES_PASSWORD=

PCA_LOG_LEVEL=INFO

# From @BotFather for @prochannelauditor_bot.
PCA_BOT_TOKEN=
PCA_BOT_USERNAME=prochannelauditor_bot

# Comma-separated numeric Telegram user IDs (get yours from @userinfobot). Usernames are rejected.
PCA_ADMIN_TELEGRAM_IDS=

# The bot resolves the numeric id from the username at startup. The bot must be an admin of the channel.
PCA_REQUIRED_CHANNEL_ID=
PCA_REQUIRED_CHANNEL_USERNAME=prochannelauditor
PCA_REQUIRED_CHANNEL_URL=https://t.me/prochannelauditor
PCA_SUBSCRIPTION_ENFORCED=true
PCA_SUBSCRIPTION_CACHE_SECONDS=120

PCA_SUPPORT_CONTACT=@prochannelauditor
# Leave empty until the HTTPS domain for the account-connection flow is set up.
PCA_PUBLIC_BASE_URL=
